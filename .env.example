# Copy to .env.local.
# Required for login. The cached signed-in diary can also work offline.
# Apply schema.sql, water_entries_migration.sql, ai_rate_limit_migration.sql,
# then ai_quota_account_cleanup.sql in a reviewed Supabase migration workflow.
# Push requires push_notifications_migration.sql and the VAPID/cron secrets above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (generate VAPID keys with: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# Public support/privacy contact shown in the Privacy Policy.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Required for persistent AI quotas and in-app account deletion. Server only.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Cost-efficient GPT-6 model for short nutrition parsing/chat requests.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# true enables anonymous API requests; the current diary UI still requires login.
# Anonymous AI also requires the server quota backend and service-role key.
# For a public app with many users, consider false so only signed-in users consume your API budget.
ALLOW_ANONYMOUS_AI=false
