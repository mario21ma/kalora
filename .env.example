# Copy to .env.local.
# Supabase is optional for a private/local diary. Add it for accounts + cloud sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Required for in-app account deletion. Keep this secret on Vercel/server only.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Cost-efficient GPT-6 model for short nutrition parsing/chat requests.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# true = AI can work for a local/guest diary without Supabase login.
# For a public app with many users, consider false so only signed-in users consume your API budget.
ALLOW_ANONYMOUS_AI=true
